#!/usr/bin/env bash
# strata-local — ciclo de vida y "minion" CLI del modelo local en la RX 9070 XT (puerto 8080, API OpenAI).
#
# Motores (STRATA_ENGINE):
#   rusting  (por defecto) RustingStrata + Qwen3.6-35B-A3B UD-Q4_K_XL (GGUF), Vulkan, 128K ctx, KV q8.
#            Expertos que no caben en VRAM corren en la CPU; el GGUF queda en page cache (reclamable).
#   inkling  (respaldo)    Strata de Niko1221 + Inkling-2-Mini SQ-15, 100% VRAM, 64K ctx (preset "daily").
#
#   strata-local start [--force]   Libera VRAM de Ollama y arranca el motor en :8080
#   strata-local stop              Detiene el motor (cualquiera de los dos que esté activo)
#   strata-local status            Estado del servidor, RAM libre y VRAM
#   strata-local logs [N]          Últimas líneas del log del motor
#   strata-local plan              Muestra la configuración (no descarga ni cambia nada)
#   strata-local calibrate         (rusting) Calibra chunk/MTP para esta máquina; con el servidor detenido
#   strata-local ask [--rtl|--iac|--rust|--review|--sum] [--think] [-f FILE]... ["pregunta"]   (stdin también)
#                  Sin --think: sin razonamiento (rápido). --think: razonamiento activado.
#
# Reglas (ver ~/.claude/skills/hybrid-local-ai/SKILL.md):
#  - No arranca si memtester o Quartus están corriendo, ni con menos de STRATA_MIN_FREE_GB de RAM disponible.
#  - Detener antes de compilar con Quartus (strata-local stop).
#  - inkling: nunca combinar --tune con otros cambios de opciones; afinar aparte con la máquina en reposo.
set -euo pipefail

ENGINE="${STRATA_ENGINE:-rusting}"
URL="${STRATA_URL:-http://127.0.0.1:8080}"
PORT="${STRATA_PORT:-8080}"
MIN_FREE_GB="${STRATA_MIN_FREE_GB:-16}"
MAX_TOKENS="${STRATA_MAX_TOKENS:-4096}"

# --- rusting (RustingStrata) ---
RS_BIN="${RS_BIN:-$HOME/.local/bin/rustingstrata}"
RS_MODEL="${RS_MODEL:-$HOME/models/gguf/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf}"
RS_BACKEND="${RS_BACKEND:-vulkan}"          # vulkan (recomendado) | hip (experimental, ver RS_HIP_*)
RS_CTX="${RS_CTX:-131072}"
RS_KV="${RS_KV:-q8}"                         # q8: 128K de KV en 1.36 GB (f16 ocupa 2.56 GB y es más lento)
RS_ALIAS="${RS_ALIAS:-qwen3.6-35b-a3b}"
RS_STATE="${RS_STATE:-$HOME/.local/state/rustingstrata}"
# HIP sin ROCm instalado: librerías hip/hiprtc de PyTorch-ROCm y cabeceras de Triton.
RS_HIP_LIB="${RS_HIP_LIB:-/opt/comfyui/venv/lib/python3.14/site-packages/torch/lib}"
RS_HIP_INCLUDE="${RS_HIP_INCLUDE:-/opt/comfyui/venv/lib/python3.14/site-packages/triton/backends/amd/include}"

# --- inkling (Strata de Niko1221) ---
STRATA_BIN="${STRATA_BIN:-$HOME/.local/bin/strata}"
PRESET="${STRATA_PRESET:-daily}"
FAMILY="${STRATA_FAMILY:-inkling-2-mini}"
MODEL="${STRATA_MODEL:-SQ-15}"
CONTEXT="${STRATA_CONTEXT:-64k}"
KV="${STRATA_KV:-fp8}"
VISION="${STRATA_VISION:-off}"

die() { echo "strata-local: $*" >&2; exit 1; }
up() { curl -sf --max-time 3 "$URL/v1/models" >/dev/null 2>&1; }
mem_avail_gb() { awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo; }

need_rs() {
  [ -x "$RS_BIN" ] || die "RustingStrata no está instalado ($RS_BIN). Ver README: gh release download -R RustingStudio/RustingStrata -p rustingstrata-linux-x86_64"
  [ -f "$RS_MODEL" ] || die "no existe el modelo $RS_MODEL (RS_MODEL)."
}
need_inkling() { [ -x "$STRATA_BIN" ] || die "Strata (inkling) no está instalado ($STRATA_BIN)."; }
has_preset() { "$STRATA_BIN" launch --list-presets 2>/dev/null | grep -qw "$PRESET"; }

rs_pid() {
  local p; p=$(cat "$RS_STATE/serve.pid" 2>/dev/null || true)
  [ -n "$p" ] && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'rustingstrata.* serve' && echo "$p"
  return 0
}

rs_env() {
  if [ "$RS_BACKEND" = "hip" ]; then
    [ -e "$RS_HIP_LIB/libhiprtc.so" ] || die "HIP: falta libhiprtc.so en $RS_HIP_LIB (RS_HIP_LIB)."
    [ -e "$RS_HIP_INCLUDE/hip/hip_runtime.h" ] || die "HIP: faltan cabeceras en $RS_HIP_INCLUDE (RS_HIP_INCLUDE)."
    mkdir -p "$RS_STATE/rocm"
    ln -sfn "$RS_HIP_LIB" "$RS_STATE/rocm/lib"
    ln -sfn "$RS_HIP_INCLUDE" "$RS_STATE/rocm/include"
    export LD_LIBRARY_PATH="$RS_STATE/rocm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export ROCM_PATH="$RS_STATE/rocm" HIP_PATH="$RS_STATE/rocm" CPATH="$RS_STATE/rocm/include"
  fi
}

free_ollama_vram() {
  if curl -sf --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ollama ps 2>/dev/null | awk 'NR>1 {print $1}' | while read -r m; do
      [ -n "$m" ] && { echo "Descargando $m de Ollama para liberar VRAM..."; ollama stop "$m" >/dev/null 2>&1 || true; }
    done
  fi
}

preflight() {
  local force="${1:-}"
  pgrep -x memtester >/dev/null && die "memtester está corriendo; no arranco hasta que termine la prueba de RAM."
  if [ "$force" != "--force" ]; then
    pgrep -f 'quartus_(map|fit|sta|asm|syn|sh)' >/dev/null && die "Quartus está compilando; espera a que termine (o --force)."
    local avail; avail=$(mem_avail_gb)
    [ "$avail" -ge "$MIN_FREE_GB" ] || die "solo ${avail} GB de RAM disponible (< ${MIN_FREE_GB} GB). Cierra cargas pesadas o usa --force."
  fi
  return 0
}

wait_up() {
  echo "Esperando a que $URL responda..."
  for _ in $(seq 1 "$1"); do up && { echo "Listo en $URL ($ENGINE)"; return 0; }; sleep 2; done
  die "el motor no respondió; revisa: strata-local logs"
}

stop_all() {
  local p; p=$(rs_pid)
  if [ -n "$p" ]; then
    kill "$p"; for _ in $(seq 1 20); do kill -0 "$p" 2>/dev/null || break; sleep 0.5; done
    kill -0 "$p" 2>/dev/null && kill -9 "$p"
    rm -f "$RS_STATE/serve.pid"; echo "RustingStrata detenido (PID $p)."
  fi
  if [ -x "$STRATA_BIN" ] && up; then
    if has_preset; then "$STRATA_BIN" launch --stop --preset "$PRESET" || "$STRATA_BIN" launch --stop; else "$STRATA_BIN" launch --stop; fi
  fi
  return 0
}

case "${1:-status}" in
  start|subir|up)
    up && { echo "Ya hay un motor activo en $URL (strata-local status; STRATA_ENGINE=$ENGINE pedido)"; exit 0; }
    preflight "${2:-}"
    free_ollama_vram
    if [ "$ENGINE" = "rusting" ]; then
      need_rs; rs_env; mkdir -p "$RS_STATE"
      setsid nohup "$RS_BIN" serve --model "$RS_MODEL" --gpu --backend "$RS_BACKEND" --ctx "$RS_CTX" --kv "$RS_KV" \
        --alias "$RS_ALIAS" --addr "127.0.0.1:$PORT" > "$RS_STATE/serve.log" 2>&1 < /dev/null &
      echo $! > "$RS_STATE/serve.pid"
      echo "RustingStrata ($RS_BACKEND, $(basename "$RS_MODEL"), ctx $RS_CTX, kv $RS_KV) PID $!"
      wait_up 150
    else
      need_inkling
      if has_preset; then
        "$STRATA_BIN" launch --preset "$PRESET" --no-tui --yes
      else
        # Primer arranque: sin --tune (no mezclar tuning con cambios de opciones) y guarda el preset.
        "$STRATA_BIN" launch --family "$FAMILY" --model "$MODEL" --context "$CONTEXT" \
          --kv "$KV" --vision "$VISION" --parallel 1 --tune skip --access lan --no-api-key --port "$PORT" \
          --save-preset "$PRESET" --no-tui --yes
      fi
      wait_up 900
    fi
    ;;
  stop|bajar|down)
    stop_all
    ;;
  status|estado)
    if up; then
      echo "Motor local: ACTIVO en $URL"
      curl -sf "$URL/v1/models" | python3 -I -c 'import sys,json; print("  modelos:", ", ".join(m["id"] for m in json.load(sys.stdin).get("data",[])))' 2>/dev/null || true
      p=$(rs_pid); [ -n "$p" ] && echo "  motor: RustingStrata (PID $p, $RS_BACKEND)" || echo "  motor: Strata/inkling (preset $PRESET)"
    else echo "Motor local: INACTIVO (al arrancar: STRATA_ENGINE=$ENGINE)"; fi
    echo "RAM disponible: $(mem_avail_gb) GB (mínimo para arrancar: ${MIN_FREE_GB} GB)"
    pgrep -x memtester >/dev/null && echo "AVISO: memtester en curso"
    pgrep -f 'quartus_(map|fit|sta|asm|syn|sh)' >/dev/null && echo "AVISO: Quartus compilando"
    command -v ollama >/dev/null && { echo "Ollama cargado:"; ollama ps 2>/dev/null | sed 's/^/  /'; }
    true
    ;;
  logs|log)
    n="${2:-40}"
    if [ -n "$(rs_pid)" ] || [ "$ENGINE" = "rusting" ]; then
      tail -n "$n" "$RS_STATE/serve.log" 2>/dev/null || die "sin log en $RS_STATE/serve.log"
    else
      f=$(ls -t "$HOME"/.local/state/strata/launch/*.engine.log 2>/dev/null | head -1 || true)
      [ -n "$f" ] && tail -n "$n" "$f" || "$STRATA_BIN" logs 2>&1 | tail -n "$n"
    fi
    ;;
  plan)
    if [ "$ENGINE" = "rusting" ]; then
      need_rs
      echo "engine=rusting bin=$RS_BIN ($("$RS_BIN" --version 2>/dev/null))"
      echo "model=$RS_MODEL backend=$RS_BACKEND ctx=$RS_CTX kv=$RS_KV alias=$RS_ALIAS port=$PORT"
      c="$HOME/.cache/rusting_strata/strata-$(basename "$RS_MODEL" .gguf)-$RS_BACKEND.json"
      [ -f "$c" ] && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); print("calibración:", d["best"], d.get("measured"))' "$c" || echo "sin calibrar: strata-local calibrate"
    else
      need_inkling
      "$STRATA_BIN" launch --plan --family "$FAMILY" --model "$MODEL" --context "$CONTEXT" --kv "$KV" --vision "$VISION" --parallel 1
    fi
    ;;
  calibrate)
    [ "$ENGINE" = "rusting" ] || die "calibrate es solo para STRATA_ENGINE=rusting (inkling usa strata launch --tune)."
    need_rs; up && die "detén el servidor antes de calibrar (strata-local stop)."
    preflight ""; rs_env
    "$RS_BIN" calibrate --model "$RS_MODEL" --backend "$RS_BACKEND" --ctx "$RS_CTX" --kv "$RS_KV" --minutes "${2:-10}"
    ;;
  ask)
    shift
    up || die "el motor local no está activo (strata-local start)."
    role="general"; files=(); q=""; effort="${STRATA_EFFORT:-none}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --rtl|--audit) role="rtl" ;;
        --iac) role="iac" ;;
        --rust) role="rust" ;;
        --review) role="review" ;;
        --sum) role="sum" ;;
        --think) effort="medium" ;;
        -f) shift; [ -f "$1" ] || die "no existe: $1"; files+=("$1") ;;
        *) q="${q:+$q }$1" ;;
      esac
      shift
    done
    STDIN=""; if [ -p /dev/stdin ] || [ -f /dev/stdin ]; then STDIN="$(cat)"; fi
    EFFORT="$effort" ROLE="$role" Q="$q" STDIN="$STDIN" URL="$URL" MAX_TOKENS="$MAX_TOKENS" python3 -I - "${files[@]}" <<'PY'
import json, os, re, sys, urllib.request
roles = {
 "general": "You are a precise senior engineer. Answer concisely. If unsure, say so; never invent APIs, flags or file contents.",
 "rtl": ("You are an FPGA RTL auditor (Intel Cyclone V, Quartus). Give a STRUCTURAL inventory only: ports with widths, "
         "parameters, clocks/resets, FSM state lists, instantiated modules, latch/width-mismatch risks. "
         "Do NOT describe cycle-by-cycle timing, clock phase or bus protocol behaviour; write 'ESCALATE: timing' if asked."),
 "iac": ("You are a DevOps/IaC engineer (Terraform/OpenTofu, Kubernetes/Helm, Ansible, GitHub Actions/GitLab CI). "
         "Produce idiomatic, minimal code with FinOps tags (owner, env, cost-center). Never quote cloud prices; "
         "pricing comes from infracost. Mark anything you are unsure about with TODO."),
 "rust": ("You are a Rust audio-plugin engineer (nih-plug, VST3/CLAP, realtime DSP). Write safe, idiomatic Rust 2021. "
          "In process() never allocate, lock, or do I/O; use atomics/smoothers for params. Prefer explicit types and "
          "#[inline] only where measured. Say when something needs cargo check/clippy verification."),
 "review": "You are a strict code reviewer. List concrete defects with file:line, most severe first. No praise, no restating code.",
 "sum": "Summarize the given files for another engineer: purpose, public interface, dependencies, risks. Bullets, max 25 lines.",
}
parts = []
for p in sys.argv[1:]:
    with open(p, errors="replace") as fh:
        parts.append(f"=== FILE: {p} ===\n{fh.read()}")
if os.environ.get("STDIN"):
    parts.append("=== STDIN ===\n" + os.environ["STDIN"])
q = os.environ.get("Q") or "Analyze the input according to your role."
effort = os.environ["EFFORT"]
body = {
  "model": "local",
  "messages": [{"role": "system", "content": roles[os.environ["ROLE"]]},
               {"role": "user", "content": ("\n\n".join(parts) + "\n\n" if parts else "") + "TASK: " + q}],
  # reasoning_effort: Strata/inkling; chat_template_kwargs.enable_thinking: RustingStrata/Qwen3.6.
  "reasoning_effort": effort, "chat_template_kwargs": {"enable_thinking": effort != "none"},
  "temperature": 0.2, "max_tokens": int(os.environ["MAX_TOKENS"]), "stream": False,
}
try:
    with urllib.request.urlopen(os.environ["URL"] + "/v1/models", timeout=5) as r:
        ids = [m["id"] for m in json.load(r).get("data", [])]
        if ids: body["model"] = ids[0]
except Exception:
    pass
req = urllib.request.Request(os.environ["URL"] + "/v1/chat/completions", json.dumps(body).encode(),
                             {"Content-Type": "application/json"})
with urllib.request.urlopen(req, timeout=900) as r:
    out = json.load(r)["choices"][0]["message"]["content"] or ""
print(re.sub(r"<think>.*?</think>\s*", "", out, flags=re.S).strip())
PY
    ;;
  *)
    sed -n '2,20p' "$0"; exit 1 ;;
esac
